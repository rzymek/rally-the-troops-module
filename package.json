{
  "name": "@rzymek/rally-the-troops-module",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzymek/rally-the-troops-module.git"
  },
  "packageManager": "pnpm@12.4.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "client/*.html",
    "tsconfig.base.json",
    "oxlint.base.json"
  ],
  "type": "module",
  "exports": {
    "./vite": "./dist/vite.js",
    "./rules": "./dist/rules/index.js",
    "./rules/framework": {
      "types": "./dist/rules/framework.d.ts"
    },
    "./client": "./dist/client/index.js",
    "./client/globals": {
      "types": "./dist/client/globals.d.ts"
    },
    "./testing": "./dist/testing/index.js",
    "./tsconfig.json": "./tsconfig.base.json",
    "./oxlint.json": "./oxlint.base.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp plugins/framework.js dist/plugins/ && cp rules/framework.d.ts dist/rules/ && cp client/globals.d.ts dist/client/",
    "prepack": "npm run build",
    "check:types": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "vite-plugin-html-inject": "^1.1.2"
  },
  "peerDependencies": {
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
